{
  "name": "papilio-theme",
  "displayName": "Papilio",
  "description": "A warm dark theme built on deep red-brown, crimson and antique gold. Fan-made and unaffiliated with HoYoverse; inspired by Hu Tao's palette from Genshin Impact.",
  "version": "0.2.0",
  "publisher": "muowl",
  "license": "MIT",
  "icon": "assets/logo.png",
  "galleryBanner": {
    "color": "#191313",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Muowl/papilio-theme.git"
  },
  "homepage": "https://github.com/Muowl/papilio-theme#readme",
  "bugs": {
    "url": "https://github.com/Muowl/papilio-theme/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "dark theme",
    "warm",
    "brown",
    "crimson",
    "italic"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Papilio",
        "uiTheme": "vs-dark",
        "path": "./themes/papilio-color-theme.json"
      },
      {
        "label": "Papilio Blood Blossom",
        "uiTheme": "vs-dark",
        "path": "./themes/papilio-blood-blossom-color-theme.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "check": "tsx scripts/check_contrast.ts && tsx scripts/check_cvd.ts && tsx scripts/check_tokens.ts",
    "build": "npm run check && tsx src/generate.ts",
    "watch": "tsx watch src/generate.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
