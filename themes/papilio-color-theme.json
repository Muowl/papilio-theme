        "meta.brace"
      ],
      "settings": {
        "foreground": "#b9a79c"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#e04a4d"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
