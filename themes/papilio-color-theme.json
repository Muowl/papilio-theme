    "variable.readonly": "#c08fcc",
    "variable.defaultLibrary": "#e04a4d",
    "parameter": {
      "foreground": "#ece0d1",
      "italic": true
    },
    "property": "#ece0d1",
    "comment": {
      "foreground": "#7d6862",
      "italic": true
    },
    "namespace": "#e0915a",
    "typeParameter": "#e0915a",
    "decorator": "#c08fcc",
