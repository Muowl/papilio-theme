{
  "$schema": "vscode://schemas/color-theme",
  "name": "Papilio",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#191313",
    "editor.foreground": "#ece0d1",
    "editorCursor.foreground": "#e04a4d",
    "editor.selectionBackground": "#4a2f2d",
    "editor.selectionHighlightBackground": "#4a2f2d99",
    "editor.wordHighlightBackground": "#3a2b28b3",
    "editor.findMatchBackground": "#c49a5d59",
    "editor.findMatchHighlightBackground": "#c49a5d2e",
    "editor.lineHighlightBackground": "#2d212080",
    "editorLineNumber.foreground": "#7d6862",
    "editorLineNumber.activeForeground": "#b9a79c",
    "editorIndentGuide.background1": "#3a2b28",
    "editorIndentGuide.activeBackground1": "#7d6862",
    "editorWhitespace.foreground": "#3a2b28",
    "editorBracketMatch.background": "#8ecfdf26",
    "editorBracketMatch.border": "#8ecfdf",
    "editorBracketHighlight.foreground1": "#e04a4d",
    "editorBracketHighlight.foreground2": "#c49a5d",
    "editorBracketHighlight.foreground3": "#8ecfdf",
    "editorBracketHighlight.foreground4": "#e89a94",
    "editorBracketHighlight.foreground5": "#e0915a",
    "editorBracketHighlight.unexpectedBracket.foreground": "#f2493b",
    "editorGutter.addedBackground": "#7fae7a",
    "editorGutter.modifiedBackground": "#c49a5d",
    "editorGutter.deletedBackground": "#f2493b",
    "diffEditor.insertedTextBackground": "#7fae7a1f",
    "diffEditor.removedTextBackground": "#f2493b1f",
    "editorError.foreground": "#f2493b",
    "editorWarning.foreground": "#e3a94f",
    "editorInfo.foreground": "#8ecfdf",
    "foreground": "#b9a79c",
    "focusBorder": "#e04a4d",
    "selection.background": "#4a2f2d",
    "descriptionForeground": "#7d6862",
    "errorForeground": "#f2493b",
    "textLink.foreground": "#8ecfdf",
    "textLink.activeForeground": "#ece0d1",
    "activityBar.background": "#211918",
    "activityBar.foreground": "#ece0d1",
    "activityBar.inactiveForeground": "#7d6862",
    "activityBarBadge.background": "#e04a4d",
    "activityBarBadge.foreground": "#191313",
    "sideBar.background": "#211918",
    "sideBar.foreground": "#b9a79c",
    "sideBarTitle.foreground": "#ece0d1",
    "sideBarSectionHeader.background": "#211918",
    "sideBarSectionHeader.foreground": "#b9a79c",
    "list.activeSelectionBackground": "#2d2120",
    "list.activeSelectionForeground": "#ece0d1",
    "list.inactiveSelectionBackground": "#2d2120b3",
    "list.hoverBackground": "#2d212080",
    "list.highlightForeground": "#e04a4d",
    "list.errorForeground": "#f2493b",
    "list.warningForeground": "#e3a94f",
    "statusBar.background": "#211918",
    "statusBar.foreground": "#b9a79c",
    "statusBar.border": "#3a2b28",
    "statusBar.debuggingBackground": "#e0915a",
    "statusBar.debuggingForeground": "#191313",
    "statusBar.noFolderBackground": "#211918",
    "statusBarItem.remoteBackground": "#e04a4d",
    "statusBarItem.remoteForeground": "#191313",
    "titleBar.activeBackground": "#211918",
    "titleBar.activeForeground": "#b9a79c",
    "titleBar.inactiveBackground": "#211918",
    "editorGroupHeader.tabsBackground": "#211918",
    "tab.activeBackground": "#191313",
    "tab.activeForeground": "#ece0d1",
    "tab.activeBorderTop": "#e04a4d",
    "tab.inactiveBackground": "#211918",
    "tab.inactiveForeground": "#7d6862",
    "tab.border": "#211918",
    "panel.background": "#211918",
    "panel.border": "#3a2b28",
    "panelTitle.activeForeground": "#ece0d1",
    "panelTitle.activeBorder": "#e04a4d",
    "terminal.background": "#211918",
    "terminal.foreground": "#ece0d1",
    "terminal.ansiBlack": "#3a2b28",
    "terminal.ansiRed": "#e04a4d",
    "terminal.ansiGreen": "#7fae7a",
    "terminal.ansiYellow": "#c49a5d",
    "terminal.ansiBlue": "#8ecfdf",
    "terminal.ansiMagenta": "#e89a94",
    "terminal.ansiCyan": "#8ecfdf",
    "terminal.ansiWhite": "#ece0d1",
    "terminal.ansiBrightBlack": "#7d6862",
    "terminal.ansiBrightRed": "#f2493b",
    "terminal.ansiBrightGreen": "#7fae7a",
    "terminal.ansiBrightYellow": "#e3a94f",
    "terminal.ansiBrightBlue": "#8ecfdf",
    "terminal.ansiBrightMagenta": "#e89a94",
    "terminal.ansiBrightCyan": "#8ecfdf",
    "terminal.ansiBrightWhite": "#ece0d1",
    "input.background": "#2d2120",
    "input.foreground": "#ece0d1",
    "input.border": "#3a2b28",
    "input.placeholderForeground": "#7d6862",
    "button.background": "#e04a4d",
    "button.foreground": "#191313",
    "button.hoverBackground": "#e0915a",
    "dropdown.background": "#2d2120",
    "dropdown.border": "#3a2b28",
    "editorWidget.background": "#211918",
    "editorWidget.border": "#3a2b28",
    "editorSuggestWidget.background": "#211918",
    "editorSuggestWidget.selectedBackground": "#2d2120",
    "editorSuggestWidget.highlightForeground": "#e04a4d",
    "editorHoverWidget.background": "#211918",
    "editorHoverWidget.border": "#3a2b28",
    "peekView.border": "#e04a4d",
    "peekViewEditor.background": "#211918",
    "peekViewResult.background": "#211918",
    "gitDecoration.modifiedResourceForeground": "#c49a5d",
    "gitDecoration.addedResourceForeground": "#7fae7a",
    "gitDecoration.deletedResourceForeground": "#f2493b",
    "gitDecoration.untrackedResourceForeground": "#8ecfdf",
    "gitDecoration.ignoredResourceForeground": "#7d6862",
    "badge.background": "#e04a4d",
    "badge.foreground": "#191313",
    "notificationCenterHeader.background": "#2d2120",
    "notifications.background": "#211918",
    "scrollbarSlider.background": "#3a2b2880",
    "scrollbarSlider.hoverBackground": "#3a2b28cc",
    "scrollbarSlider.activeBackground": "#7d686299",
    "widget.shadow": "#19131399"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7d6862",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e04a4d"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#e89a94"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#c49a5d"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#c49a5d"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#8ecfdf"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#e0915a"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ece0d1"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ece0d1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#ece0d1"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#b9a79c"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#b9a79c"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#e04a4d"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c49a5d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#e0915a"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e0915a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#e04a4d",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#e89a94"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8ecfdf"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#8ecfdf"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#e0915a"
      }
    },
    {
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#ece0d1"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f2493b"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#8ecfdf",
    "method": "#8ecfdf",
    "class": "#e0915a",
    "interface": "#e0915a",
    "type": "#e0915a",
    "enum": "#e0915a",
    "enumMember": "#c49a5d",
    "variable.readonly": "#c49a5d",
    "parameter": {
      "foreground": "#ece0d1",
      "italic": true
    },
    "property": "#ece0d1",
    "comment": {
      "foreground": "#7d6862",
      "italic": true
    }
  }
}
