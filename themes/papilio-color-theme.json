      "settings": {
        "foreground": "#e0915a"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#c08fcc"
      }
    },
    {
      "scope": [
        "variable.parameter"
